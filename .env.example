# Copy to .env.local and fill in. Never commit real values.

# ---- Browser (Vite) ----
# Your Supabase project URL and anon (public) key. For local development,
# run `supabase start` and copy the values from `supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Set to true only after Google is enabled in your Supabase Auth project.
VITE_GOOGLE_AUTH_ENABLED=false
VITE_FEEDBACK_REALTIME_ENABLED=true
# Optional: Sentry browser DSN. Leave empty to disable error reporting.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=

# ---- Server side: set as Supabase Edge Function secrets, not in the browser ----
#   npx supabase secrets set --project-ref <your-project-ref> \
#     ANTHROPIC_API_KEY=... OPENAI_API_KEY=... GEMINI_API_KEY=... \
#     JARGON_SITE_ORIGINS=https://your-domain.example \
#     JARGON_SITE_URL=https://your-domain.example
#
# ANTHROPIC_API_KEY     Claude text generation (personalize-term, grade-sentence,
#                       compose-gift-profile, generate-job-followup, ingest-terms)
# OPENAI_API_KEY        Embeddings for duplicate detection in ingest-terms
# GEMINI_API_KEY        Optional badge image generation
# JARGON_SITE_ORIGINS   Comma-separated browser origins allowed by CORS
# JARGON_SITE_URL       Redirect base URL for magic-link invites
# AI_GATEWAY_BASE_URL / AI_GATEWAY_API_KEY   Optional LLM gateway proxy
# JARGON_SPEND_CAP_USER_USD (default 5) and JARGON_SPEND_CAP_GLOBAL_USD (default 50): monthly AI spend ceilings
#
# ---- Vercel environment (cron proxy) ----
# CRON_SECRET             Required for /api/cron/ingest-terms; the route fails closed without it
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
