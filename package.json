{
  "name": "jargon",
  "private": true,
  "license": "MIT",
  "version": "0.5.3",
  "description": "Speak the room. A spaced-repetition game for technical vocabulary.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "lint": "echo 'no lint configured'",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "test:ai-spend-acl": "bash scripts/test-ai-spend-acl.sh",
    "test:sql": "bash scripts/test-sql.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "pre-deploy": "npm run test:pre-deploy-auth-gate && node scripts/pre-deploy.mjs",
    "test:pre-deploy-auth-gate": "node --test scripts/pre-deploy-auth-gate.test.mjs",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "design-tokens": "file:vendor/design-tokens",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.3",
    "@sentry/react": "^10.52.0",
    "@supabase/supabase-js": "^2.45.4",
    "html2canvas-pro": "2.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "supabase": "^2.98.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "8.0.16",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "brace-expansion": "^5.0.9",
    "form-data": "^4.0.6",
    "tar": "^7.5.22",
    "ws": "^8.21.3",
    "nanoid@>=3 <4": "^3.3.18"
  }
}
