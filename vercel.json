{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run pre-deploy",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ingest-terms",
      "schedule": "0 6 * * 0"
    }
  ]
}
